# Caminho da planilha (a mesma que a automação em Python preenche)
PLANILHA_PATH=H:\3. Gestão\VOX FIDC\8.Estudos e levantamentos\2026\Fluxo Operacional\Acompanhamento de Fluxo Operacional - Vox.xlsx

# Fluxo de caixa: pasta onde fica a versão final (publicada) de cada mês.
# O site lê só daqui. O mês vem do nome do arquivo (ex.: "CashFlow Vox - Setembro 2026.xlsx").
CAIXA_PUBLICADO=H:\3. Gestão\VOX FIDC\8.Estudos e levantamentos\CashFlow VOX - Publicado
# Na primeira vez, o site cria a pasta acima e copia para ela os meses deste período
# (a partir das pastas de trabalho). Arquivos já publicados nunca são substituídos.
CAIXA_IMPORTAR=2026-07:2026-09
CAIXA_TRABALHO=H:\3. Gestão\VOX FIDC\8.Estudos e levantamentos\{ANO}\CashFlow VOX\{MES}\CashFlow Vox - {MES_NOME} {ANO}.xlsx

# Primeiro mês que aparece no filtro do site
CAIXA_DESDE=2026-07

# Porta do servidor
PORTA=3001

# Horário a partir do qual o dia de hoje é considerado consolidado
HORA_FECHAMENTO=19:00

# Situação do dia no topo: "Concluído" quando as liquidações do dia e as baixas conciliadas
# estiverem feitas; se faltar algo a partir deste horário, fica "Encerrado"
HORA_ENCERRAMENTO=18:00

# Liquidação: se a saída não aparecer no extrato até esse horário, o card passa de
# "Aguardando informações" para "Não realizado" (volta a OK se a saída aparecer depois)
LIMITE_LIQUIDACAO_ENDOSSO=15:00
# Extração RPE: até esse horário, arquivos faltando aparecem como "Aguardando informações"
LIMITE_RPE=14:00
# Arquivos da Bauk (Processamento, Baixas, endosso): até esse horário fica "Aguardando"
LIMITE_ARQUIVOS_BAUK=10:30
LIMITE_LIQUIDACAO_URFA=17:00

# De quantos em quantos minutos a tela busca dados novos na planilha
INTERVALO_ATUALIZACAO_MIN=10

# Mostra a coluna Responsável no quadro de observações (true ou false)
MOSTRAR_RESPONSAVEL=true

# Só para testes: finge que agora é esta data/hora. Deixe vazio no uso real.
SIMULAR_AGORA=

# ============================ LOGIN ============================
# Acesso de administrador. TROQUE A SENHA antes de colocar o site no ar.
ADMIN_USUARIO=admin
ADMIN_SENHA=admin2027

# Só e-mails destes domínios (exatos, depois do @) podem se cadastrar
DOMINIOS_PERMITIDOS=h2kapital.com.br,voxcred.com.br,tendaatacado.com.br

# Por quantas horas a pessoa fica logada
SESSAO_HORAS=12

# Ligue quando o site estiver online com https
COOKIE_SEGURO=false

# ============================ SITE ONLINE (Supabase) ============================
# Preenchidos pelo configurar-online.bat. A chave SECRET fica só aqui (nunca vai pro GitHub).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# E-mail que o admin usa para entrar no site online (a senha é a ADMIN_SENHA, acima)
ADMIN_EMAIL=

# ============================ STATUS DA BAUK (cards de liquidação) ============================
# O publicador consulta a tela Negociação da Bauk e mostra nos cards de URFA/Endosso
# "Aguardando Aprovações" ou "Aguardando Liquidação". false = desliga.
BAUK_STATUS=true
# De quantos em quantos minutos consulta (dias úteis, das 8h às 20h)
BAUK_INTERVALO_MIN=2
# Login da Bauk. Vazio = usa o mesmo do script da automação (AUTOMACAO_PY)
BAUK_EMAIL=
BAUK_SENHA=
AUTOMACAO_PY=C:\Automacao\Vox\preencher_fluxo_operacional_vox.py
